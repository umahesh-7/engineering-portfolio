# Copy to .env.local for local development. Every variable is optional:
# without it the matching feature degrades gracefully (see README).

# Canonical site URL used for metadata, sitemap, RSS and the API docs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form delivery (Resend). Without a key, submissions are logged to the server console.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Upstash Redis for rate limiting and view counts. Without it an in-memory limiter is used and view counts are disabled.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile bot protection on the contact form. Without keys the check is skipped.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional read-only GitHub token: unlocks the contribution calendar via GraphQL.
GITHUB_TOKEN=
